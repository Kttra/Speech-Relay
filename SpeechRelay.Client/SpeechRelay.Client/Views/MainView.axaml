<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SpeechRelay.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SpeechRelay.Client.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

    <ScrollViewer Padding="20">
        <StackPanel Spacing="20">

            <TextBlock Text="Phone Speaker Controller"
                        FontSize="24"
                        HorizontalAlignment="Center"
                        Margin="0,10"
                        FontWeight="Bold"/>

            <StackPanel Spacing="5">
                <TextBlock Text="PC IP Address" FontSize="16" FontWeight="Bold"/>
                <TextBox Text="{Binding PcIp}"
                            HorizontalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            MinHeight="40"/>
            </StackPanel>

			<StackPanel Spacing="5">
				<TextBlock Text="Auth Token" FontSize="16" FontWeight="Bold"/>
				<TextBox Text="{Binding AuthToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40"/>
			</StackPanel>
			
            <StackPanel Spacing="5">
                <TextBlock Text="Text to Speak" FontSize="16" FontWeight="Bold" />
                <TextBox Text="{Binding CommandText}"
                            HorizontalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            MinHeight="40"/>
            </StackPanel>

			<StackPanel Spacing="5">
				<TextBlock Text="Voice Generator" FontSize="16" FontWeight="Bold"/>
				<ComboBox MinHeight="40"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectedItem="{Binding SelectedVoiceGenerator}">
					<x:String>Windows Narrator</x:String>
					<x:String>Azure Speech</x:String>
					<x:String>Piper</x:String>
				</ComboBox>
			</StackPanel>
			
			<StackPanel Spacing="5">
				<TextBlock Text="Voice Selection"
						   FontSize="16"
						   FontWeight="Bold"/>

				<ComboBox MinHeight="40"
						  HorizontalAlignment="Stretch"
						  ItemsSource="{Binding AvailableVoices}"
						  SelectedItem="{Binding SelectedVoice}" />
			</StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Preset Message" FontSize="16" FontWeight="Bold"/>
                <ComboBox MinHeight="40"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectedItem="{Binding SelectedPresetMsg}">
                    <x:String>Custom</x:String>
                    <x:String>Yes sir</x:String>
                    <x:String>No sir</x:String>
                    <x:String>Restroom</x:String>
                    <x:String>Brushing teeth</x:String>
                    <x:String>Downstairs</x:String>
                </ComboBox>
            </StackPanel>

            <!-- Send Button -->
            <Button Content="Send"
                    Command="{Binding SendCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    MinHeight="45"
                    Background="#4CAF50"
                    Foreground="White"
                    FontSize="18"
                    FontWeight="Bold"/>

            <!-- Scan Pairing Button (Android only for now) -->
            <Button Content="Scan Pairing (Camera)"
                    Command="{Binding ScanPairingFromCameraCommand}"
					IsVisible="{Binding IsAndroid}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    MinHeight="45"
                    Background="#2196F3"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"/>

            <TextBlock Text="{Binding ServerResponse}"
                TextWrapping="Wrap"
                HorizontalAlignment="Stretch"
                Margin="5,10,5,5" />
       </StackPanel>
    </ScrollViewer>
</UserControl>
